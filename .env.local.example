# --------------------------------------------------------------------------
# CrowdRoast — local dev environment
# Copy this file to .env.local and fill in any blanks marked TODO.
# .env.local is git-ignored; never commit real keys.
# --------------------------------------------------------------------------

# ---- Local Supabase ------------------------------------------------------
# These are the SHARED DEFAULTS that every local `supabase start` instance
# uses — they're public, not secrets. Don't change them unless you've also
# changed the corresponding values in supabase/config.toml.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
SUPABASE_SERVICE_ROLE_KEY=sb_secret_N7UND0UgjKTVK-Uodkm0Hg_xSvEMPvz

# Auth redirect for the dev OAuth/magic-link flow.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated list of admin email addresses (for admin role assignment).
# At least one is required for the admin dashboards to work.
ADMIN_EMAILS=you@example.com
ADMIN_EMAIL=you@example.com

# ---- Stripe sandbox -----------------------------------------------------
# Get these from https://dashboard.stripe.com/test/apikeys (your sandbox
# account, NOT your live account). The boot validator will refuse to start
# if STRIPE_SECRET_KEY is missing or malformed; it logs the mode loudly so
# you always know whether you're hitting test or live.
STRIPE_SECRET_KEY=sk_test_TODO
STRIPE_WEBHOOK_SECRET=whsec_TODO

# Your platform's Connect account ID (the parent account that holds the
# connected sellers). In your Stripe sandbox dashboard, this is the
# account ID at the top of the Connect overview page.
CROWDROAST_STRIPE_CONNECT_ACCOUNT_ID=acct_TODO

# ---- Cron auth -----------------------------------------------------------
# Any string you want — only needs to match between the cron wrapper script
# and the route handler. Doesn't need to match prod's value.
CRON_SECRET=local-dev-cron-secret

# ---- Resend (transactional email) ---------------------------------------
# Optional locally — set to a Resend API key if you want to test emails,
# otherwise leave blank and emails will no-op.
RESEND_API_KEY=
